# ---- Database ----
DATABASE_URL=postgresql+psycopg://localhost/blurt

# ---- Audio storage ----
STORAGE_BACKEND=local                 # local | s3
AUDIO_DIR=./data/audio                # used when STORAGE_BACKEND=local
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=blurt-audio-dev
S3_ACCESS_KEY_ID=                     # secret: Keychain → .envrc / k8s Secret
S3_SECRET_ACCESS_KEY=                 # secret
AUDIO_RETENTION_DAYS=14
MAX_UPLOAD_MB=25

# ---- Speech to text ----
STT_PROVIDER=mlx                      # mlx | groq | fake
STT_MODEL=mlx-community/whisper-small # groq: whisper-large-v3-turbo
GROQ_API_KEY=                         # secret
STT_TRANSLATE=false                   # true = transcribe-and-translate to English
                                      # (handles Hindi/Marathi/etc.; groq uses whisper-large-v3)

# ---- LLM ----
LLM_BASE_URL=http://localhost:11434/v1    # Ollama locally; cloud OpenAI-compatible URL in prod
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama                    # Ollama ignores it; real keys are secrets

# ---- Pipeline ----
ROUTER_CONFIDENCE_THRESHOLD=0.7
WORKER_CONCURRENCY=1

# ---- Frontend ----
API_INTERNAL_URL=http://localhost:8000    # where Next.js proxies /api (http://api:8000 in cluster)

# ---- Auth ----
JWT_SECRET=dev-secret-change-in-production   # secret in prod
JWT_EXPIRE_MINUTES=480                        # 8 hours

# ---- WebAuthn / passkeys ----
WEBAUTHN_RP_ID=localhost                       # registrable domain, no scheme/port
WEBAUTHN_RP_NAME=Blurt
WEBAUTHN_ORIGIN=http://localhost:5200          # must EXACTLY match the browser origin (scheme+host+port)
